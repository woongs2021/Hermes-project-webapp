{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.august-dashboard/schemas/research-board.schema.json",
  "title": "August Dashboard public-safe research board",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "sourcePolicy", "status", "items"],
  "properties": {
    "version": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourcePolicy": {
      "const": "public-safe research board manifest only; exposes chronological paper metadata, safe summaries, source links, lane labels, and validation/caution text; excludes raw logs, credentials, private IDs, local source paths, and hidden prompts"
    },
    "status": { "const": "public_research_board_allowed" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/researchItem" }
    }
  },
  "$defs": {
    "researchItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "dateKst",
        "isoWeek",
        "lane",
        "owner",
        "title",
        "thumbnailLabel",
        "sourceVenue",
        "sourceAccess",
        "sourceUrlOrId",
        "publicationDate",
        "summary",
        "chrisRelevance",
        "koreanSourceStatus",
        "score",
        "duplicateSignal",
        "publicSafe"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "dateKst": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "isoWeek": { "type": "string", "pattern": "^\\d{4}-W\\d{2}$" },
        "lane": { "enum": ["yuna", "goyounjung"] },
        "owner": { "enum": ["yuna", "goyounjung"] },
        "title": { "type": "string", "minLength": 1 },
        "thumbnailLabel": { "type": "string", "minLength": 1, "maxLength": 12 },
        "sourceVenue": { "type": "string", "minLength": 1 },
        "sourceAccess": { "type": "string", "minLength": 1 },
        "sourceUrlOrId": { "type": "string", "minLength": 1 },
        "publicationDate": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "chrisRelevance": { "type": "string", "minLength": 1 },
        "koreanSourceStatus": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 0, "maximum": 5 },
        "duplicateSignal": { "type": "string", "minLength": 1 },
        "publicSafe": { "const": true }
      }
    }
  }
}
