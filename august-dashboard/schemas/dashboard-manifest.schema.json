{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.august-dashboard/schemas/dashboard-manifest.schema.json",
  "title": "August Dashboard Public-Safe Manifest",
  "description": "Public-safe generated manifest only; no raw DM, credentials, OAuth/API keys, private IDs, or private source text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "sourcePolicy", "documents"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourcePolicy": {
      "type": "string",
      "const": "public-safe generated manifest only; no raw DM, credentials, OAuth/API keys, private IDs, or private source text"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/publicSafeDocument"
      }
    }
  },
  "$defs": {
    "publicSafeDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title", "section", "format", "publicSafe", "summary", "bodyPreview"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/data/.+\\.(md|json)$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": ["Metaphor Loops", "Overview", "Team", "OBD", "Research", "Muyeol Report"]
        },
        "format": {
          "type": "string",
          "enum": ["markdown", "json"]
        },
        "publicSafe": {
          "type": "boolean",
          "const": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "bodyPreview": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "markdown"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "format": {
                "const": "json"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "\\.json$"
              }
            }
          }
        }
      ]
    }
  }
}
